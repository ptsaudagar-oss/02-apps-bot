# 🐳 Dockerfile for 02-TELEGRAM_BOT on Koyeb Cloud (24/7 Autonomous Engine)
FROM python:3.11-slim

LABEL maintainer="PT. Saudagar <pt.saudagar@gmail.com>"
LABEL service="telegram-gmail-bot"
LABEL cloud="koyeb"
LABEL region="sin"
LABEL description="Autonomous Telegram Gmail Assistant Container for Koyeb 24/7"

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PORT=8000

# Install minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY . /app

# Expose Koyeb default service port
EXPOSE 8000

# Koyeb Health check probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Start standalone Telegram Gmail Bot
CMD ["python", "02-TELEGRAM_BOT/00-GMAIL_BOT/main.py"]
