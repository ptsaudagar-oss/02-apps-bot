# 🐳 Dockerfile for 02-TELEGRAM_BOT on Fly.io (24/7 Continuous Machine Engine)
FROM python:3.11-slim

LABEL maintainer="PT. Saudagar <pt.saudagar@gmail.com>"
LABEL service="telegram-gmail-bot"
LABEL cloud="fly.io"
LABEL region="sin"
LABEL description="Autonomous Telegram Gmail Assistant Container for Fly.io 24/7 Always-On"

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PORT=8080

# Install minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY . /app

# Expose Fly.io standard internal service port
EXPOSE 8080

# Health check probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/health || exit 1

# Start both Telegram Gmail Bot & WhatsApp Bridge Server
CMD ["python", "apps_bot_manager.py", "run", "all"]
