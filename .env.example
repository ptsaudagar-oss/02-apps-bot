# ==============================================================================
# APPS_BOT MASTER CONFIGURATION FILE (.env)
# Direktori: C:\Users\kafnu\Downloads\00-ANTIGRAVITY AI\00-APPS\02-APPS_BOT\.env
# ==============================================================================

# Mode Debug (true / false)
DEBUG=true

# ------------------------------------------------------------------------------
# 1. AI ASSISTANT CONFIGURATION (Google GenAI / Gemini)
# ------------------------------------------------------------------------------
# API Key untuk Gemini (otomatis mengaktifkan ekstraksi dan ringkasan eksekutif)
GEMINI_API_KEY=
# Model rilis aktif yang direkomendasikan
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 2. MODUL 00-TELEGRAM_BOT (00-G-MAIL_BOT)
# ------------------------------------------------------------------------------
# Token Bot Telegram didapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=
# Whitelist Chat ID Telegram yang diizinkan mengakses bot (pisahkan koma jika jamak)
# Contoh: 12345678,87654321 (Kosongkan jika ingin mengizinkan interaksi uji coba)
TELEGRAM_AUTHORIZED_CHAT_IDS=
# Interval polling bot Telegram (detik)
TELEGRAM_POLLING_INTERVAL=3

# ------------------------------------------------------------------------------
# 3. GMAIL INTEGRATION CONFIGURATION
# ------------------------------------------------------------------------------
# Alamat email Gmail yang akan dipantau dan dikelola
GMAIL_USER_EMAIL=
# Google App Password (16 karakter dibuat di https://myaccount.google.com/apppasswords)
# Mode ini sangat stabil dan tidak memerlukan approval OAuth2 consent yang rumit
GMAIL_APP_PASSWORD=
# Mode autentikasi: 'app_password' (direkomendasikan) atau 'oauth2'
GMAIL_AUTH_MODE=app_password
# Interval pengecekan email masuk baru untuk notifikasi push (detik)
GMAIL_CHECK_INTERVAL_SECONDS=60

# ------------------------------------------------------------------------------
# 4. MODUL 01-WHATSAPP_BOT (Meta Cloud API dengan Failover ke Local Gateway)
# Kebijakan: 'Meta dahulu. Jika gagal, ke lokal gateway saja'
# ------------------------------------------------------------------------------
# Token verifikasi untuk handshake webhook Meta (Bebas ditentukan, sesuaikan di dashboard Meta)
WHATSAPP_VERIFY_TOKEN=APPS_BOT_WHATSAPP_SECRET_TOKEN
# Provider prioritas utama ('meta')
WHATSAPP_PROVIDER_PRIMARY=meta
# Access Token permanen/sistem dari Meta Business Developer
WHATSAPP_ACCESS_TOKEN=
# Phone Number ID dari Meta Developer Portal
WHATSAPP_PHONE_NUMBER_ID=
# Versi Graph API Meta
WHATSAPP_API_VERSION=v21.0
# Base URL Gateway Meta (default: Meta Graph API)
WHATSAPP_GATEWAY_URL=https://graph.facebook.com

# Failover ke Local Gateway Bridge jika Meta gagal / offline (true / false)
WHATSAPP_FAILOVER_TO_LOCAL=true
# URL Local Gateway Bridge (Baileys / WPPConnect / Custom HTTP Bridge)
WHATSAPP_LOCAL_GATEWAY_URL=http://127.0.0.1:3000/api/send

# Server Webhook Lokal untuk menerima webhook event Meta
WHATSAPP_SERVER_HOST=127.0.0.1
WHATSAPP_SERVER_PORT=8080
